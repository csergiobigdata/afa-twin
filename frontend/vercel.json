{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://SUBSTITUA-PELA-URL-DO-BACKEND.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://SUBSTITUA-PELA-URL-DO-BACKEND.onrender.com/media/:path*" },
    { "source": "/((?!api/|media/).*)", "destination": "/index.html" }
  ]
}
